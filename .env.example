# Copy to `.env` and fill in your own values. Never commit the real .env.

# Gmail the assistant sends/reads from (use a Gmail App Password, not your login):
# https://myaccount.google.com/apppasswords
GMAIL_EMAIL=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_NAME=AI Payroll Assistant

# Local working folder for the agent vault
VAULT_PATH=vault
